# --- Core ---
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/studio.db
DEV_MODE=1                       # returns OTP codes in API responses and enables mock payments. Set 0 in production.
SECRET_KEY=change-me             # used to hash OTP codes and phone numbers
BRAND_NAME=Jewellery Image Studio
CORS_ORIGINS=*

# --- Pipeline providers ---
CUTOUT_PROVIDER=rembg            # rembg | threshold
REMBG_MODEL=isnet-general-use   # ~1.3 GB memory. birefnet-general has finer edges but needs a 6 GB+ server
SCENE_PROVIDER=replicate         # replicate | mock
UPSCALE_PROVIDER=replicate       # replicate | lanczos
REPLICATE_API_TOKEN=
FLUX_FILL_MODEL=black-forest-labs/flux-fill-pro
ESRGAN_MODEL=nightmareai/real-esrgan   # pin a version in production: owner/name:versionhash
PREVIEW_LONG_SIDE=1024
WHITE_BALANCE_STRENGTH=0.5      # 0 = off, 1 = full. Full correction turned silver blue on cream backdrops; tune with the evaluation harness

# --- Credits (spec §9.7, §12) ---
TRIAL_CREDITS=3                  # free trial, once per phone number
INITIAL_GENERATION_COST=1        # first image for a product
ADDITIONAL_GENERATION_COST=1     # every further image for the same product
QUALITY_REFUND_AUTO_LIMIT=5      # automatic refunds for reported detail errors per user per 30 days; beyond this, manual review

# --- Uploads ---
MAX_UPLOAD_MB=25
MAX_PHOTOS_PER_PRODUCT=8

# --- Sign-in (phone OTP) ---
SMS_PROVIDER=console             # console (logs the code) | add your SMS gateway in app/sms.py

# --- Credit packs (price in INR; leave blank until decided) ---
PACK_STARTER_PRICE_INR=
PACK_SHOP_PRICE_INR=
PACK_STUDIO_PRICE_INR=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Operations console (/admin) ---
ADMIN_TOKENS=                    # name:long-random-token pairs, comma-separated, e.g. priya:3f9c...,rahul:a71b...
COST_PER_SCENE_INR=0             # your provider's price per background generation, for cost-per-image metrics
COST_PER_UPSCALE_INR=0           # price per upscale
