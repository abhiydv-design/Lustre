# --- Core ---
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/lustre.db
DEV_MODE=1                       # enables /auth/dev-login and mock payments. Set 0 in production.
BRAND_NAME=Lustre
CORS_ORIGINS=*

# --- Pipeline providers ---
CUTOUT_PROVIDER=rembg            # rembg | threshold
REMBG_MODEL=birefnet-general
SCENE_PROVIDER=replicate         # replicate | mock
UPSCALE_PROVIDER=replicate       # replicate | lanczos
REPLICATE_API_TOKEN=
FLUX_FILL_MODEL=black-forest-labs/flux-fill-pro
ESRGAN_MODEL=nightmareai/real-esrgan   # pin a version in production: owner/name:versionhash

# --- Product rules ---
PREVIEW_LONG_SIDE=1024
PREVIEW_WATERMARK=1
FREE_CREDITS=3
DAILY_PREVIEW_JOBS=20
MAX_UPLOAD_MB=25

# --- Credit packs (price in INR; leave blank until decided) ---
PACK_STARTER_PRICE_INR=
PACK_SHOP_PRICE_INR=
PACK_STUDIO_PRICE_INR=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
